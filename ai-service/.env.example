# Proposed AI service configuration; not loaded until service implementation.
ENVIRONMENT=development
PORT=8000
# Retrieval database connection; use a dedicated least-privilege account.
DATABASE_URL=
GEMINI_API_KEY=
# Shared with the backend; never send this value to Flutter.
AI_SERVICE_TOKEN=
# Configure real immutable artifacts and compatible versions in the ML phases.
MODEL_PATH=
MODEL_VERSION=
PREPROCESSING_VERSION=
