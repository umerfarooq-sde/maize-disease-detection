# Server-only Phase 8 settings, loaded from this directory by python -m app.server.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Optional for loopback development health; required in production/non-loopback.
# Generate a random base64url token with at least 32 random bytes. Never send to Flutter.
AI_SERVICE_TOKEN=
# Future retrieval/provider/model settings below are not used or required in Phase 8.
# Retrieval database connection will need a dedicated least-privilege account.
DATABASE_URL=
GEMINI_API_KEY=
# Configure real immutable artifacts and compatible versions in the ML phases.
MODEL_PATH=
MODEL_VERSION=
PREPROCESSING_VERSION=
