# Server-only settings, loaded from this directory by python -m app.server.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Required for inference, production or non-loopback binding.
# Generate a random base64url token with at least 32 random bytes. Never send to Flutter.
AI_SERVICE_TOKEN=
# Retrieval is opt-in and requires all explicit provider settings below.
# Use a dedicated least-privilege account for production retrieval.
DATABASE_URL=
GEMINI_API_KEY=
RAG_ENABLED=false
# Selected text-only model/version are recorded in docs/30-knowledge-retrieval.md.
# Supply them explicitly; no provider model is guessed or embedded in source.
EMBEDDING_MODEL=
EMBEDDING_VERSION=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=8
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=120
RAG_MAX_CONCURRENCY=4
# Grounded generation is independently opt-in. Server only; no source-code model fallback.
GENERATION_ENABLED=false
GEMINI_MODEL=
GENERATION_TIMEOUT_SECONDS=12
GENERATION_MAX_CONCURRENCY=2
GENERATION_CONTEXT_CHARS=6000
GENERATION_MAX_CHUNKS=8
# Relative to ai-service, or absolute deployment paths. Pin the reviewed version
# (e.g. ../backend/knowledge/<corpus-version>.json and its .review.json).
GENERATION_CORPUS_PATH=
GENERATION_REVIEW_PATH=
# Inference is enabled by default. Missing or incompatible artifacts fail startup.
# False is an explicit health-only maintenance/test mode; prediction remains unavailable.
INFERENCE_ENABLED=true
# Paths resolve relative to ai-service; keep weight files external/ignored.
MODEL_PATH=
MODEL_METADATA_PATH=
MODEL_METADATA_SHA256=
MODEL_VERSION=
PREPROCESSING_VERSION=
INFERENCE_THREADS=2
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_UPLOAD_TIMEOUT_SECONDS=10
# Optional pinned, approved validation-only policy. Leave both blank for the approved
# model's unlocked policy: all predictions LOW_CONFIDENCE / THRESHOLD_UNCONFIGURED.
CONFIDENCE_POLICY_PATH=
CONFIDENCE_POLICY_SHA256=
