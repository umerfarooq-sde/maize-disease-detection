# Server-only settings, loaded from this directory by python -m app.server.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Required for inference, production or non-loopback binding.
# Generate a random base64url token with at least 32 random bytes. Never send to Flutter.
AI_SERVICE_TOKEN=
# Retrieval/provider settings remain unused in Phase 11.
# Retrieval database connection will need a dedicated least-privilege account.
DATABASE_URL=
GEMINI_API_KEY=
# Inference is enabled by default. Missing or incompatible artifacts fail startup.
# False is an explicit health-only maintenance/test mode; prediction remains unavailable.
INFERENCE_ENABLED=true
# Paths resolve relative to ai-service; keep weight files external/ignored.
MODEL_PATH=
MODEL_METADATA_PATH=
MODEL_METADATA_SHA256=
MODEL_VERSION=
PREPROCESSING_VERSION=
INFERENCE_THREADS=2
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_UPLOAD_TIMEOUT_SECONDS=10
# Optional pinned, approved validation-only policy. Leave both blank for the approved
# model's unlocked policy: all predictions LOW_CONFIDENCE / THRESHOLD_UNCONFIGURED.
CONFIDENCE_POLICY_PATH=
CONFIDENCE_POLICY_SHA256=
