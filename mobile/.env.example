# Public build configuration only; never bundled as an asset or loaded as .env.
# Pass with --dart-define or --dart-define-from-file; leave blank for offline shell.
# localhost is suitable for a desktop client; device/emulator URLs differ.
# Android emulator typically uses http://10.0.2.2:3000/api/v1.
# A physical device needs the development machine's reachable network address.
API_BASE_URL=
