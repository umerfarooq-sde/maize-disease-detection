# MAIZEDOCTOR Flutter Environment Configuration Example
# Copy this file to .env in the mobile project root and set your API base URL.
# Local development examples:
# - Android emulator: http://10.0.2.2:3000/api/v1
# - Physical device / LAN: http://<your-machine-ip>:3000/api/v1
# - Production: https://your-domain.com/api/v1
API_BASE_URL=https://your-domain.com/api/v1
# Optional: Enforce HTTPS check (defaults to true for production, false for local http:// URLs)
# REQUIRE_HTTPS=false
