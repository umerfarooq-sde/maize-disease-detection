{
  "name": "maizedoctor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MAIZEDOCTOR versioned backend foundation and Prisma persistence",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.database.json",
    "build": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "tsx --test tests/foundation/*.test.ts tests/auth/*.test.ts tests/scans/*.test.ts",
    "test:scans:database": "tsx --test tests/scans.database.integration.ts",
    "test:scans:live": "tsx --test tests/scans.live.integration.ts",
    "test:scans:mobile": "npm run build && node ../scripts/check-scan-upload.mjs",
    "scans:cleanup": "tsx src/cli/cleanup-scan-uploads.ts",
    "test:auth:database": "tsx --test tests/auth.database.integration.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && node dist/environment-check.js",
    "check:database": "npm run build && node dist/database-check.js",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:check:migrations": "tsx tests/migration-replay.ts",
    "db:check": "npm run db:validate && npm run db:generate && npm run typecheck && tsx --test tests/database.integration.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
