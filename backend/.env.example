# Server-only configuration. Prisma runtime and the SQL probe use DATABASE_URL.
NODE_ENV=development
PORT=3000
# Bind locally by default; set HOST=0.0.0.0 explicitly for containers/LAN access.
HOST=127.0.0.1
# Exact comma-separated browser origins; blank denies browser cross-origin requests.
# Requests without Origin (mobile/server clients) are permitted. No wildcard or URL userinfo.
# Allowed browser origins receive credentialed CORS for the HttpOnly refresh cookie.
CORS_ORIGINS=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Per-IP, per-process limit in a 60-second window (including health).
RATE_LIMIT_MAX=120
# Combined registration/login requests per IP in a 15-minute window.
AUTH_RATE_LIMIT_MAX=10
# Scan attempts per IP in a 15-minute window; applied before reading image bytes.
SCAN_RATE_LIMIT_MAX=10
# Full PostgreSQL URL; initialize-dev-env.ps1 generates the local port-5433 value.
DATABASE_URL=
# Optional direct session URL for migrations/replay; required with cloud transaction poolers.
# Leave blank for an ordinary unpooled local PostgreSQL connection. pgvector is required.
# Prisma CLI defaults connect_timeout to 30 seconds; an explicit URL value overrides it.
DIRECT_DATABASE_URL=
# Required, independent random base64url keys, at least 32 decoded bytes each.
# Generate ignored local keys with scripts/initialize-auth-env.ps1; never print them.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=maizedoctor
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Server-only: configure all three to enable scan uploads. All blank = uploads return 503.
# Partial configuration fails startup validation. No upload presets/client credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only inference: all four identity/configuration values blank disables inference.
# Origin only, e.g. http://127.0.0.1:8000 or a trusted private Docker service origin.
# No paths, credentials, query strings or fragments; never accept a URL from a user.
AI_SERVICE_URL=
# Shared random base64url credential (32+ decoded bytes); match the AI service.
AI_SERVICE_TOKEN=
# Explicit approved versions; validated against every prediction, never guessed.
AI_MODEL_VERSION=
AI_PREPROCESSING_VERSION=
# Complete request/response deadline, inclusive of streamed response bytes (1000-20000).
AI_SERVICE_TIMEOUT_MS=10000
