# Copy to an ignored operator environment. Secret JSON contents never go here.
STACK_NAME=maizedoctor
API_HOST=
PUBLIC_HTTPS_ORIGIN=
CORS_ORIGINS=
SECRETS_DIRECTORY=
MODEL_DIRECTORY=
CLOUDINARY_CLOUD_NAME=
EMBEDDING_MODEL=
EMBEDDING_VERSION=
EMBEDDING_DIMENSIONS=768
GEMINI_MODEL=
NODE_IMAGE=
AI_IMAGE=
MIGRATION_IMAGE=
TLS_CONFIGURATION=./tls-production.caddy
CLEANUP_INTERVAL_SECONDS=300
OPERATIONS_IMAGE=
BACKUP_INTERVAL_SECONDS=86400
PRIVACY_INTERVAL_SECONDS=300
# Default policy disables all erasure/retention. Mount a reviewed version only after approval.
PRIVACY_POLICY_FILE=./privacy-policy.example.json
