[Unit]
Description=MAIZEDOCTOR private read-only container lifecycle observation
After=docker.service
[Service]
Type=oneshot
User=maizedoctor-operator
EnvironmentFile=/etc/maizedoctor/observer.env
ExecStart=/opt/maizedoctor-operations/bin/python /opt/maizedoctor/infrastructure/operations/observe_containers.py --namespace ${STACK_NAME} --token ${OPERATIONS_TOKEN_FILE} --url ${PRIVATE_ALERTS_URL}
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
